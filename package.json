{
  "name": "music-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "import:spotify": "esbuild scripts/import-spotify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/import-spotify.mjs --log-level=error && node node_modules/.cache/import-spotify.mjs",
    "fetch:spotify": "esbuild scripts/fetch-spotify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fetch-spotify.mjs --log-level=error && node node_modules/.cache/fetch-spotify.mjs",
    "fetch:instagram-authors": "esbuild scripts/fetch-instagram-authors.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fetch-instagram-authors.mjs --log-level=error && node node_modules/.cache/fetch-instagram-authors.mjs",
    "fetch:artists": "esbuild scripts/fetch-artists.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fetch-artists.mjs --log-level=error && node node_modules/.cache/fetch-artists.mjs",
    "fetch:keys": "esbuild scripts/fetch-keys.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fetch-keys.mjs --log-level=error && node node_modules/.cache/fetch-keys.mjs",
    "fetch:song-info": "esbuild scripts/fetch-song-info.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fetch-song-info.mjs --log-level=error && node node_modules/.cache/fetch-song-info.mjs",
    "fetch:history": "esbuild scripts/fetch-history.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fetch-history.mjs --log-level=error && node node_modules/.cache/fetch-history.mjs",
    "import:vocal-ranges": "esbuild scripts/import-vocal-ranges.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/import-vocal-ranges.mjs --log-level=error && node node_modules/.cache/import-vocal-ranges.mjs",
    "validate": "esbuild scripts/validate-scores.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/validate.mjs --log-level=error && node node_modules/.cache/validate.mjs"
  },
  "dependencies": {
    "@types/vexflow": "^3.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.83.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
